# Mercury - AI Trading Agent
# Copy to .env and fill in your keys
# NEVER commit .env to git

# Primary LLM (DeepSeek)
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Fallback LLM (Claude - for complex analysis)
ANTHROPIC_API_KEY=sk-ant-your-key

# Stock Data
FINNHUB_API_KEY=your-finnhub-key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Dashboard Auth (required for non-loopback access)
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=mercury
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=your-secure-password
